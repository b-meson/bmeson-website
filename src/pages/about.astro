	<div>
		<div id="my-pdf"></div>
		<script is:inline src="https://unpkg.com/pdfobject"></script>
		<script is:inline>
			const pdfObject = window["PDFObject"];
			if (pdfObject) {
				pdfObject.embed(
					"/docs/martinez_cv_2026_redacted.pdf",
					"#my-pdf",
				);
			}
		</script>

		<style>
			.my-pdf {
				color: var(--success-content);
				border: #ccc 4px solid;
			}
			.pdfobject-container {
				height: 920px;
				border: 1px solid #ccc;
			}
			a {
				color: var(--primary-content);
				transition: color 0.2s ease-in-out;
			}
			a:link {
				color: var(--primary-content);
			}

			/* visited link */
			a:visited {
				color: var(--primary-content);
			}

			/* mouse over link */
			a:hover {
				color: var(--warning-content);
			}

			/* selected link */
			a:active {
				color: var(--primary-content);
			}
		</style>
	</div>
</Layout>
