---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>

<html lang="en" data-theme="dark">


	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="main">
			<h1>🧑‍🚀 Welcome visitor</h1>
			<br>
			<p>
				Hi everyone, I am working on building this new personal site for myself. Click the About link to learn more about my professional life.
			</p>

			<p>
				This website is built using <a href="https://astro.build/">Astro</a>. I have a strong dislike of JavaScript and all things front-end so its nice to use a static site generator. 
			</p>
		</main>
		<Footer />
	</body>
</html>
