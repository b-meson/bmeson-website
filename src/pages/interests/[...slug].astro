---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import InterestsPost from '../../layouts/InterestsPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('interests');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'interests'>;

const post = Astro.props;
const { Content } = await render(post);
---

<InterestsPost {...post.data}>
	<Content />
</InterestsPost>
