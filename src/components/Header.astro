---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<input class="menu-toggle" type="checkbox" id="menu-toggle" aria-label="Show navigation links">
		<label class="menu-toggle-label" for="menu-toggle">Menu</label>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/interests">Stuff I Find Interesting</HeaderLink>
			<HeaderLink href="/about">About & CV</HeaderLink>
		</div>	
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0.5em 1em;
		background: linear-gradient(var(--foreground)) no-repeat;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h1 {
		margin: 12px 0 12px 0;
        font-family: 'Zen Maru Gothic', sans-serif;
		display: flex;
		align-items: left;
		justify-content: left;
	}
	h2 {
		margin: 12px 0 12px 0;
		font-size: clamp(1.25rem, 4vw, 2em);
		font-family: 'Zen Maru Gothic', sans-serif;
		line-height: 1.2;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		flex-wrap: wrap;
	}
	.menu-toggle,
	.menu-toggle-label {
		display: none;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--copy-light);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--copy-light);
	}

	nav a:hover {
		text-decoration: none;
		color: var(--warning-content, #ffff8e);
	}


	.social-links,
	.social-links a {
		display: flex;
	}

	.internal-links {
		padding-right: 2.5em;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	@media (max-width: 720px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
		}
		.menu-toggle-label {
			display: inline-block;
			padding: 0.65em 0.25em;
			color: var(--copy-light);
			cursor: pointer;
		}
		.menu-toggle {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
		}
		.menu-toggle:focus-visible + .menu-toggle-label {
			outline: 2px solid currentColor;
			outline-offset: 2px;
		}
		.internal-links {
			width: 100%;
			padding-right: 0;
			flex-direction: column;
			display: none;
		}
		.menu-toggle:checked ~ .internal-links {
			display: flex;
		}
		nav a {
			padding: 0.65em 0.25em;
		}

		.social-links {
			display: none;
		}
	}
</style>
