---
const today = new Date();
import { Icon } from 'astro-icon/components'
---

<footer>
	🏴 There is no such thing as intellectual property. 🏴
	<div class="social-links">
		<a href="https://bsky.app/profile/bmeson.lucyparsonslabs.com" target="_blank">
			<span class="srb-only">Follow Me on Bluesky</span>
			<Icon class="bsk-icon-footer" name="bluesky" />
		</a>
		<a href="https://bsky.app/profile/lucyparsonslabs.com" target="_blank">
			<span class="srb-only">Follow LPL on Bluesky</span>
			<Icon class="bsk-icon-footer" name="bluesky" />
		</a>
	</div>
</footer>

<style>
	footer {
		padding: 1em 1em 4em 1em;
		background: linear-gradient(var(--foreground));
		color: rgb(var(--gray));
		text-align: center;
		font-family: 'Zen Maru Gothic', sans-serif;
		bottom:0;
		position: relative;
  		width:100%;
   		height:60px; /* Height of the footer */
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 4em;
		margin-top: 1em;
		font-family: 'Zen Maru Gothic', sans-serif;
		padding-right: 8px;

	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		padding-right: 8px;
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
		padding-right: 8px;

	}

	.bsk-icon-footer {
		padding-left: 8px;
	}
</style>
