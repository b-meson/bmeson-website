---
const today = new Date();
import { Icon } from 'astro-icon/components'
---

<footer>
	🏴 There is no such thing as intellectual property. 🏴
	<div class="social-links">
		<a href="https://bsky.app/profile/bmeson.lucyparsonslabs.com" target="_blank">
			<span class="srb-only">Follow Me on Bluesky</span>

			<Icon name="bluesky" />
		</a>
		<a href="https://bsky.app/profile/lucyparsonslabs.com" target="_blank">
			<span class="srb-only">Follow LPL on Bluesky</span>
			<Icon name="bluesky" />
		</a>
	</div>
</footer>

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-family: 'Zen Maru Gothic', sans-serif;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 4em;
		margin-top: 1em;
		font-family: 'Zen Maru Gothic', sans-serif;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		padding-right: 8px;
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
